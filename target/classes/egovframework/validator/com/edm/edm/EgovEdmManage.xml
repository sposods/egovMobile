<form-validation>

    <formset>
		<form name="edmManageVO">

			<field property="categoryId" depends="required,maxlength">
        		<arg0 key="edmManageVO.categoryId" resource="true"/>
        		<arg1 key="20" resource="true"/>
				<var>
				<var-name>maxlength</var-name>
				<var-value>20</var-value>
				</var>
			</field>

			<field property="expenseDt" depends="required, maxlength">
        		<arg0 key="edmManageVO.expenseDt" resource="true"/>
        		<arg1 key="20" resource="true"/>
				<var>
				<var-name>maxlength</var-name>
				<var-value>20</var-value>
				</var>
			</field> 

			<field property="expenseTm" depends="maxlength">
        		<arg0 key="edmManageVO.expenseTm" resource="true"/>
        		<arg1 key="14" resource="true"/>
				<var>
				<var-name>maxlength</var-name>
				<var-value>14</var-value>
				</var>
			</field>
			
			<field property="amount" depends="required, maxlength">
        		<arg0 key="edmManageVO.amount" resource="true"/>
        		<arg1 key="10" resource="true"/>
				<var>
				<var-name>maxlength</var-name>
				<var-value>10</var-value>
				</var>
			</field>			

			<field property="expenseNote" depends="maxlength">
        		<arg0 key="edmManageVO.expenseNote" resource="true"/>
